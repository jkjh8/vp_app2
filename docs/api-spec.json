{
  "info": {
    "title": "VP App2 API",
    "version": "0.5.9",
    "description": "네트워크 멀티 윈도우 비디오 플레이어 제어 REST API + socket.io 상태 스트림. 재생 출력은 항상 플레이리스트(장면/윈도우) 기반이며, 단일 파일 직접 재생은 폐지됨(파일은 /api/files/raw 미리보기 전용).",
    "contact": {
      "name": "jkjh8",
      "url": "https://github.com/jkjh8"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server (REST base: /api, socket.io namespace: /client, event: pStatus). 포트는 VP_WEB_PORT로 오버라이드 가능."
    }
  ],
  "endpoints": {
    "player": {
      "play": {
        "method": "GET",
        "path": "/api/player/play/:id",
        "description": "재생/재개. 플레이리스트·장면·타임라인 모드를 자동 분기. :id는 레거시로 무시됨.",
        "params": { "id": "number (무시됨)" }
      },
      "stop": {
        "method": "GET",
        "path": "/api/player/stop",
        "description": "정지. 모드에 따라 전 창 동시 정지 + 상태 초기화."
      },
      "pause": {
        "method": "GET",
        "path": "/api/player/pause/:id",
        "description": "일시정지/재개 토글(전 창·오디오 일괄). :id는 무시됨.",
        "params": { "id": "number (무시됨)" }
      },
      "fullscreen": {
        "method": "GET",
        "path": "/api/player/fullscreen/:value",
        "description": "전체화면 설정.",
        "params": { "value": "'true' | 'false'" }
      },
      "background": {
        "method": "POST",
        "path": "/api/player/background",
        "description": "배경색 설정.",
        "body": { "color": "string" }
      },
      "setAudioDevice": {
        "method": "PUT",
        "path": "/api/player/setaudiodevice",
        "description": "출력 오디오 장치 설정.",
        "body": { "deviceId": "string" }
      },
      "hwaccel": {
        "method": "PUT",
        "path": "/api/player/hwaccel",
        "description": "하드웨어 가속 설정(저장 후 플레이어 재시작으로 적용).",
        "body": { "value": "'auto' | 'on' | 'off'" }
      },
      "masterVolume": {
        "method": "PUT",
        "path": "/api/player/master_volume",
        "description": "전역 마스터 볼륨(저장, 슬라이더 릴리즈).",
        "body": { "value": "number (0-100)" }
      },
      "masterVolumeLive": {
        "method": "PUT",
        "path": "/api/player/master_volume/live",
        "description": "전역 마스터 볼륨(전송만, 드래그 — 저장 안 함).",
        "body": { "value": "number (0-100)" }
      },
      "repeat": {
        "method": "GET",
        "path": "/api/player/repeat",
        "description": "반복 모드 순환 토글 (none -> all -> repeat_one).",
        "response": { "message": "string", "mode": "none | all | repeat_one" }
      },
      "next": {
        "method": "GET",
        "path": "/api/player/next",
        "description": "다음 트랙."
      },
      "prev": {
        "method": "GET",
        "path": "/api/player/prev",
        "description": "이전 트랙(5초 이내면 이전 트랙, 아니면 현재 트랙 처음으로)."
      },
      "audioDevices": {
        "method": "GET",
        "path": "/api/player/audio_devices",
        "description": "오디오 장치 목록 조회 요청(결과는 pStatus.audioDevices로 푸시)."
      },
      "displays": {
        "method": "GET",
        "path": "/api/player/displays",
        "description": "모니터 목록 조회 요청(결과는 pStatus.displays로 푸시)."
      },
      "setDisplay": {
        "method": "PUT",
        "path": "/api/player/display",
        "description": "전역 디스플레이 배치 설정.",
        "body": {
          "monitorIndex": "number (-1 = primary)",
          "x": "number",
          "y": "number",
          "width": "number (0 = full)",
          "height": "number (0 = full)",
          "aspectMode": "'letterbox' | 'crop' | 'stretch'"
        }
      },
      "listWindows": {
        "method": "GET",
        "path": "/api/player/windows",
        "description": "출력 창 목록 조회.",
        "response": { "windows": "array", "playerWindows": "array" }
      },
      "createWindow": {
        "method": "POST",
        "path": "/api/player/windows",
        "description": "출력 창 생성.",
        "body": {
          "name": "string (optional)",
          "monitorIndex": "number (optional)",
          "x": "number (optional)",
          "y": "number (optional)",
          "width": "number (optional)",
          "height": "number (optional)",
          "aspectMode": "string (optional)",
          "backgroundColor": "string (optional)"
        }
      },
      "updateWindow": {
        "method": "PUT",
        "path": "/api/player/windows/:id",
        "description": "출력 창 수정(라이브 재배치).",
        "params": { "id": "number" },
        "body": "createWindow와 동일 필드"
      },
      "deleteWindow": {
        "method": "DELETE",
        "path": "/api/player/windows/:id",
        "description": "출력 창 삭제(참조 클립 자동 정리).",
        "params": { "id": "number" }
      },
      "preload": {
        "method": "PUT",
        "path": "/api/player/preload",
        "description": "전 트랙 프리롤 설정.",
        "body": { "lookahead": "number (optional)", "maxDecks": "number (optional)" }
      },
      "channelDelays": {
        "method": "PUT",
        "path": "/api/player/channel_delays",
        "description": "출력 채널별 오디오 지연(ms) 설정.",
        "body": { "delays": "number[]" }
      },
      "getSync": {
        "method": "GET",
        "path": "/api/player/sync",
        "description": "멀티 PC 클럭 동기 설정 조회(pStatus.sync)."
      },
      "setSync": {
        "method": "PUT",
        "path": "/api/player/sync",
        "description": "멀티 PC 클럭 동기 설정.",
        "body": {
          "role": "'standalone' | 'master' | 'slave' (optional)",
          "domain": "number (optional)",
          "peers": "string[] (optional)",
          "multicastAddr": "string (optional)",
          "multicastPort": "number (optional)",
          "leadMs": "number (optional)"
        }
      }
    },
    "playlist": {
      "list": {
        "method": "GET",
        "path": "/api/playlist",
        "description": "플레이리스트 전체 조회(트랙 파일정보 하이드레이션 포함)."
      },
      "create": {
        "method": "POST",
        "path": "/api/playlist",
        "description": "플레이리스트 생성.",
        "body": { "playlistId": "number", "name": "string (optional)", "mode": "'scene' | 'window' (optional)" }
      },
      "update": {
        "method": "PUT",
        "path": "/api/playlist",
        "description": "플레이리스트 수정.",
        "body": { "id": "string (_id)", "...updateData": "any" }
      },
      "tracks": {
        "method": "PUT",
        "path": "/api/playlist/tracks",
        "description": "트랙 추가(append).",
        "body": { "id": "string (_id)", "tracks": "array" }
      },
      "select": {
        "method": "PUT",
        "path": "/api/playlist/select",
        "description": "현재 열람 중 플레이리스트 지정(편집 시 프리로드 대상).",
        "body": { "playlistId": "number" }
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/playlist/:id",
        "description": "플레이리스트 삭제(_id 기준).",
        "params": { "id": "string (_id)" }
      },
      "play": {
        "method": "GET",
        "path": "/api/playlist/play",
        "description": "플레이리스트 재생(로드된 타입 mode에 따라 장면/윈도우 분기).",
        "query": { "playlistId": "number", "trackIndex": "number (optional, default 0)" }
      },
      "preload": {
        "method": "GET",
        "path": "/api/playlist/preload",
        "description": "재생 없이 전 트랙 프리롤(로딩 버튼).",
        "query": { "playlistId": "number" }
      },
      "playbackmode": {
        "method": "PUT",
        "path": "/api/playlist/playbackmode",
        "description": "전역 작업 모드 토글(에디터/목록/신규 기본 타입 힌트 — 재생 분기 아님).",
        "body": { "value": "'scene' | 'window'" }
      },
      "modeSwitch": {
        "method": "PUT",
        "path": "/api/playlist/mode_switch",
        "description": "플레이리스트 1개 타입 즉시 전환(트랙 형태 변환 포함).",
        "body": { "id": "string (_id)", "mode": "'scene' | 'window'" }
      },
      "windowPlay": {
        "method": "GET",
        "path": "/api/playlist/window/play",
        "description": "윈도우 모드: 단일 창 재생.",
        "query": { "playlistId": "number (optional)", "windowId": "number", "index": "number (optional, default 0)" }
      },
      "windowStop": {
        "method": "GET",
        "path": "/api/playlist/window/stop",
        "description": "윈도우 모드: 단일 창 정지.",
        "query": { "windowId": "number" }
      },
      "deckAudioLive": {
        "method": "PUT",
        "path": "/api/playlist/deck_audio/live",
        "description": "재생 중 임베디드 오디오 라이브 변경(재조회 없이 즉시).",
        "body": { "window_id": "number (optional)", "streams": "array (optional)", "channel_map": "array (optional)", "volume": "number (optional)", "muted": "boolean (optional)" }
      },
      "trackAudioLive": {
        "method": "PUT",
        "path": "/api/playlist/track_audio/live",
        "description": "재생 중 추가 오디오 라이브 변경.",
        "body": { "audioId": "string", "volume": "number (optional)", "muted": "boolean (optional)", "channels": "array (optional)" }
      },
      "track": {
        "method": "PUT",
        "path": "/api/playlist/track",
        "description": "트랙(장면) 부분 갱신(영속).",
        "body": { "id": "string (_id)", "idx": "number", "patch": { "clips": "array (optional)", "audios": "array (optional)" } }
      },
      "imageTime": {
        "method": "PUT",
        "path": "/api/playlist/image_time",
        "description": "이미지 트랙 표시 시간 설정.",
        "body": { "playlistId": "string (_id)", "idx": "number", "time": "number" }
      },
      "startOnPlay": {
        "method": "PUT",
        "path": "/api/playlist/start_on_play",
        "description": "부팅 시 자동재생 on/off.",
        "body": { "value": "boolean" }
      },
      "startOnPlaylistId": {
        "method": "PUT",
        "path": "/api/playlist/start_on_playlist_id",
        "description": "부팅 자동재생 대상 플레이리스트 지정.",
        "body": { "playlistId": "number" }
      }
    },
    "files": {
      "list": {
        "method": "GET",
        "path": "/api/files",
        "description": "파일 목록 조회."
      },
      "upload": {
        "method": "POST",
        "path": "/api/files",
        "description": "파일 업로드(후처리 포함).",
        "body": "multipart/form-data (any fields)"
      },
      "thumbnail": {
        "method": "GET",
        "path": "/api/files/thumbnail/:uuid",
        "description": "섬네일 이미지 서빙.",
        "params": { "uuid": "string" }
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/files/:uuid",
        "description": "파일 삭제(디스크 폴더 + DB).",
        "params": { "uuid": "string" }
      },
      "download": {
        "method": "GET",
        "path": "/api/files/download/:uuid",
        "description": "파일 다운로드(첨부).",
        "params": { "uuid": "string" }
      },
      "raw": {
        "method": "GET",
        "path": "/api/files/raw/:uuid",
        "description": "인라인 원본 스트리밍(브라우저 미리보기용, range 지원).",
        "params": { "uuid": "string" }
      },
      "checkId": {
        "method": "GET",
        "path": "/api/files/check-id/:id",
        "description": "파일 ID 중복 검사.",
        "params": { "id": "string" },
        "response": { "exists": "boolean", "id": "string" }
      },
      "updateId": {
        "method": "PUT",
        "path": "/api/files/:uuid/id",
        "description": "파일 ID 변경(영문/숫자/_/- 만 허용, 중복 검사).",
        "params": { "uuid": "string" },
        "body": { "newId": "string" }
      },
      "resetAll": {
        "method": "GET",
        "path": "/api/files/reset_all",
        "description": "전 파일 reserved 상태 초기화."
      }
    },
    "status": {
      "get": {
        "method": "GET",
        "path": "/api/status",
        "description": "현재 상태 조회.",
        "response": { "pStatus": "object (pStatus 스키마 참조)" }
      },
      "update": {
        "method": "POST",
        "path": "/api/status/update",
        "description": "상태 키 임의 갱신(+DB 영속).",
        "body": { "key": "string", "value": "any" }
      },
      "logoList": {
        "method": "GET",
        "path": "/api/status/logo",
        "description": "로고 파일 목록."
      },
      "logoUpload": {
        "method": "POST",
        "path": "/api/status/logo",
        "description": "로고 파일 업로드.",
        "body": "multipart/form-data"
      },
      "logoImg": {
        "method": "GET",
        "path": "/api/status/logo/img/:filename",
        "description": "로고 이미지 서빙.",
        "params": { "filename": "string" }
      },
      "logoDelete": {
        "method": "DELETE",
        "path": "/api/status/logo/:filename",
        "description": "로고 파일 삭제.",
        "params": { "filename": "string" }
      },
      "logoSelect": {
        "method": "GET",
        "path": "/api/status/logo/sel/:filename",
        "description": "로고 선택/적용.",
        "params": { "filename": "string" }
      },
      "logoShow": {
        "method": "GET",
        "path": "/api/status/logo/show/:show",
        "description": "로고 표시 on/off.",
        "params": { "show": "'true' | 'false'" }
      },
      "logoSize": {
        "method": "PUT",
        "path": "/api/status/logo/size",
        "description": "로고 크기 설정.",
        "body": { "size": "number" }
      }
    },
    "timeline": {
      "list": {
        "method": "GET",
        "path": "/api/timeline",
        "description": "타임라인 목록 조회."
      },
      "create": {
        "method": "POST",
        "path": "/api/timeline",
        "description": "타임라인 생성.",
        "body": { "...": "any" }
      },
      "update": {
        "method": "PUT",
        "path": "/api/timeline",
        "description": "타임라인 수정.",
        "body": { "...": "any" }
      },
      "play": {
        "method": "GET",
        "path": "/api/timeline/play",
        "description": "타임라인 재생(시작 위치 지정 가능).",
        "query": { "timelineId": "string", "time": "number (optional)" }
      },
      "pause": {
        "method": "GET",
        "path": "/api/timeline/pause",
        "description": "일시정지/재개 토글."
      },
      "stop": {
        "method": "GET",
        "path": "/api/timeline/stop",
        "description": "정지(해체 + 모드 해제 + 위치 초기화)."
      },
      "seek": {
        "method": "PUT",
        "path": "/api/timeline/seek",
        "description": "탐색.",
        "body": { "time_ms": "number (또는 time)" }
      },
      "get": {
        "method": "GET",
        "path": "/api/timeline/:id",
        "description": "개별 타임라인 조회.",
        "params": { "id": "string" }
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/timeline/:id",
        "description": "타임라인 삭제.",
        "params": { "id": "string" }
      }
    }
  },
  "socketio": {
    "namespace": "/client",
    "event": "pStatus",
    "note": "부분 패치로 전송. 다음 키는 통째 교체(키 삭제가 의미를 가짐): windowStates, preloadStatus, audioTracks, memory, windows, playerWindows. 전체 스키마는 docs/API_MANUAL.md의 pStatus 섹션 참조."
  },
  "tcp": {
    "note": "REST/socket API와 별개의 외부 제어 인터페이스(재설계 v2). 명령은 domain.action 네임스페이스 전용(레거시 flat 명령 없음). 상세는 docs/TCP_PROTOCOL.md 참조.",
    "protocolVersion": "2.0",
    "simplePort": 15000,
    "jsonPort": 15001,
    "commands": [
      "player.play",
      "player.pause",
      "player.stop",
      "player.next",
      "player.prev",
      "player.seek",
      "player.fullscreen",
      "playlist.play",
      "playlist.preload",
      "playlist.list",
      "playlist.get",
      "mode.set",
      "mode.get",
      "mode.switch",
      "window.play",
      "window.stop",
      "window.next",
      "window.prev",
      "window.list",
      "preload.config",
      "preload.get",
      "audio.setdevice",
      "audio.listdevices",
      "audio.getdevice",
      "audio.mastervolume",
      "audio.getmastervolume",
      "audio.channeldelays",
      "display.set",
      "display.list",
      "display.background",
      "logo.show",
      "logo.size",
      "repeat.set",
      "repeat.get",
      "timeline.play",
      "timeline.pause",
      "timeline.stop",
      "timeline.seek",
      "startonplay.set",
      "startonplay.get",
      "system.status",
      "system.version",
      "system.capabilities",
      "files.list"
    ],
    "events": [
      "playerReady",
      "playStarted",
      "playPaused",
      "playStopped",
      "nextTrack",
      "prevTrack",
      "trackEnded",
      "endReached",
      "mediaChanged",
      "fullscreenChanged",
      "audioDevicesUpdated",
      "playbackModeChanged",
      "windowStopped",
      "repeatChanged"
    ]
  }
}
