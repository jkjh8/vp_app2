{
  "name": "vp_app2",
  "version": "0.1.8",
  "main": "src/main.js",
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development nodemon --exec electron .",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.vpapp2",
    "productName": "VP App",
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      {
        "from": "player_python/.venv",
        "to": "player/.venv",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.pyd",
          "!**/test/**",
          "!**/tests/**",
          "!**/pip/**",
          "!**/setuptools/**",
          "!**/wheel/**"
        ]
      },
      {
        "from": "player_python/player.py",
        "to": "player/player.py"
      },
      {
        "from": "player_python/requirements.txt",
        "to": "player/requirements.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./public/icons/icon.ico",
      "uninstallerIcon": "./public/icons/icon.ico",
      "uninstallDisplayName": "VP App Uninstaller"
    }
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nedb-promises": "^6.2.3",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
